# OmShare - Production Environment Variables
# Copy this to .env.local for development, .env.production for production

# ==========================================
# FIREBASE CONFIGURATION
# ==========================================

# Required: Your Firebase project configuration
# Get these from Firebase Console → Project Settings → Your apps → Web app
VITE_FIREBASE_API_KEY=YOUR_API_KEY_HERE
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef123456
VITE_FIREBASE_MEASUREMENT_ID=G-ABCDEF1234

# ==========================================
# SECURITY SETTINGS
# ==========================================

# Code expiration time in milliseconds (default: 24 hours)
VITE_CODE_EXPIRY=86400000

# Maximum transfer duration in milliseconds (default: 2 hours)
VITE_MAX_TRANSFER_DURATION=7200000

# Maximum file size in bytes (leave empty for unlimited)
# Example: 1GB = 1073741824
VITE_MAX_FILE_SIZE=

# Rate limiting: codes per IP per hour
VITE_RATE_LIMIT_CODES_PER_HOUR=10

# Rate limiting: transfers per IP per day
VITE_RATE_LIMIT_TRANSFERS_PER_DAY=50

# ==========================================
# PERFORMANCE SETTINGS
# ==========================================

# WebRTC chunk size in bytes (default: 64KB)
VITE_CHUNK_SIZE=65536

# ICE servers for WebRTC
# Default: Google STUN servers, add TURN for better connectivity
VITE_STUN_SERVERS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302,stun:stun2.l.google.com:19302
VITE_TURN_SERVERS=

# ==========================================
# APP SETTINGS
# ==========================================

# App name (displayed in UI)
VITE_APP_NAME=OmShare

# Enable/disable analytics
VITE_ENABLE_ANALYTICS=false

# Debug mode (shows console logs)
VITE_DEBUG=false

# ==========================================
# NETLIFY SPECIFIC
# ==========================================

# Netlify build time variables
NETLIFY=true

# Netlify functions region
AWS_REGION=us-east-1

# ==========================================
# DEPLOYMENT ENVIRONMENT
# ==========================================

# Set to 'production' for production builds
NODE_ENV=production

# Enable minification and optimization
VITE_BUILD_OPTIMIZE=true

# ==========================================
# MONITORING (Optional)
# ==========================================

# Sentry DSN for error tracking (optional)
VITE_SENTRY_DSN=

# Google Analytics ID (optional)
VITE_GA_ID=

# ==========================================
# CUSTOMIZATION
# ==========================================

# Primary brand color (hex)
VITE_PRIMARY_COLOR=#FF6B35

# Accent color (hex)
VITE_ACCENT_COLOR=#00D4AA

# Dark mode (true/false) - App uses dark mode by default
VITE_DARK_MODE=true

# Enable service worker for PWA
VITE_ENABLE_SERVICE_WORKER=true

# ==========================================
# FEATURE FLAGS
# ==========================================

# Enable file preview (before download)
VITE_FEATURE_PREVIEW=false

# Enable multi-file transfer
VITE_FEATURE_MULTI_FILE=false

# Enable resume on connection drop
VITE_FEATURE_RESUME=false

# Enable encryption (end-to-end)
VITE_FEATURE_ENCRYPTION=true

# ==========================================
# WEBRTC ADVANCED SETTINGS
# ==========================================

# ICE gathering timeout (ms)
VITE_ICE_TIMEOUT=5000

# Data channel reliability settings
VITE_DC_ORDERED=true
VITE_DC_MAX_RETRANSMITS=0

# Bandwidth estimation
VITE_BANDWIDTH_ESTIMATION=true

# ==========================================
# CLEANUP SETTINGS
# ==========================================

# Auto-delete old transfers after (hours)
VITE_CLEANUP_AGE_HOURS=24

# Auto-cleanup interval (minutes)
VITE_CLEANUP_INTERVAL_MINUTES=60